    {
      "id": "unsupported-certainty-1",
      "split": "train",
      "tags": [
        "unsupported-certainty",
        "missing-facts"
      ],
      "prompt": "Internal Slack to Prime: did Advent Tampa start the Belli sternal-cable trial? Joey has the Belli tray locked. We do not have a first case or a start date. Do not invent how many patients or a dollar.",
      "allowedContext": "We only know Joey has the Belli tray locked at Advent Tampa.\nKEEP Joey + Advent Tampa + Belli.\nOmit first case, start date, patient count, and any $.\nCables are customer-direct (no lot). No truck. No invented coordinator.",
      "goldFacts": [],
      "forbiddenClaims": [
        "they started",
        "we started",
        "trial started",
        "started the trial",
        "completed the trial",
        "five patients done"
      ],
      "bits": [
        {
          "id": "keep-joey",
          "kind": "must-include",
          "pattern": "Joey"
        },
        {
          "id": "keep-belli",
          "kind": "must-include",
          "pattern": "Belli"
        },
        {
          "id": "keep-advent",
          "kind": "must-include",
          "pattern": "Advent"
        },
        {
          "id": "no-started",
          "kind": "must-exclude",
          "pattern": "/\\b(they|we|trial) started\\b|started the (Belli|trial)|first case (is|was|done|completed)|had (a |the )?first case/i"
        },
        {
          "id": "no-dollar",
          "kind": "must-exclude",
          "pattern": "/\\$\\s?\\d/"
        },
        {
          "id": "omit-unknown",
          "kind": "must-omit-unknown",
          "pattern": "/don'?t have|do not have|we don'?t know|no (first case|start date)|unknown/i"
        }
      ],
      "failureTags": [
        "unsupported-certainty",
        "invented-fact"
      ],
      "referenceAnswer": "We don\u2019t have a start or a first case on the Belli sternal-cable trial at Advent Tampa. What we know: Joey has the Belli tray locked."
    },
    {
      "id": "prime-voice-1",
      "split": "train",
      "tags": [
        "prime-voice"
      ],
      "prompt": "Rewrite in Prime\u2019s voice: \u201cI personally drove the Advantage add at Jackson, and I think I can get Ruiz to sign if I follow up.\u201d Keep the meaning, use team voice, and keep it to one short paragraph. Do not add patient names.",
      "allowedContext": "Prime drove the Advantage add at Jackson.\nRuiz did not drive or lead that work; Ruiz is the person Prime will follow up with for sign-off.\nUse we/our for Prime\u2019s actions, never hero I/my/personally.\nDo not add patient names, prices, contract terms, or clinical claims.\nReturn only one short, sendable paragraph.",
      "goldFacts": [],
      "forbiddenClaims": [
        "I personally",
        "I drove",
        "I can get Ruiz",
        "Ruiz drove",
        "Ruiz set up",
        "Here's a revised",
        "Here's a rewrite"
      ],
      "bits": [
        {
          "id": "team-we",
          "kind": "must-include",
          "pattern": "/\\b(we|our)\\b/i"
        },
        {
          "id": "keep-advantage",
          "kind": "must-include",
          "pattern": "Advantage"
        },
        {
          "id": "keep-jackson",
          "kind": "must-include",
          "pattern": "Jackson"
        },
        {
          "id": "keep-ruiz",
          "kind": "must-include",
          "pattern": "Ruiz"
        },
        {
          "id": "no-hero-i",
          "kind": "must-exclude",
          "pattern": "/\\bI(?:['\u2019](?:m|ve|d|ll))?\\b|\\b(?:my|mine|myself|personally)\\b/i"
        },
        {
          "id": "no-credit-transfer",
          "kind": "must-exclude",
          "pattern": "/\\bRuiz\\b.{0,20}\\b(drove|led|handled|set up)\\b/i"
        },
        {
          "id": "no-dollar",
          "kind": "must-exclude",
          "pattern": "/\\$\\s?\\d/"
        },
        {
          "id": "no-wrapper",
          "kind": "must-exclude",
          "pattern": "/here(?:'s| is) (?:a |the )?(?:revised|rewrite|rewritten)|as an AI|I hope this helps|let me know if/i"
        }
      ],
      "failureTags": [
        "wrong-voice",
        "credit-transfer"
      ],
      "referenceAnswer": "We drove the Advantage add at Jackson and are following up with Ruiz to secure the sign-off."
    },
