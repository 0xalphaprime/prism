# Copy to .env.local (never commit real keys)
# Or pull from your home env:
#   grep -E '^(OPENAI|XAI|OPEN_ROUTER|ANTHROPIC|AIRTABLE|GITHUB|KNOWLEDGE|FIRECRAWL)_' ~/.env >> .env.local

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# xAI / Grok
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1

# Anthropic (direct Messages API)
# Either name works — your ~/.env uses ANTHROPIC_CURSOR_API
ANTHROPIC_API_KEY=
ANTHROPIC_CURSOR_API=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# OpenRouter (Claude, open-source, many others — one key)
OPEN_ROUTER_HERMES_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:3001
OPENROUTER_APP_NAME=Prism

# Ollama (OpenAI-compat /v1). Foundry neural node over Tailscale:
#   OLLAMA_BASE_URL=http://100.78.81.94:11434/v1
# Local daemon:
#   OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_API_KEY=

# Shared PRIMARY map — same keys and values as Foundry's env, so one block can live in both repos.
# Foundry prefers these names; it still accepts the older FOUNDRY_PRIMARY_* names as fallbacks. Prism reads only the names below.
#
# PRIMARY = default student / Ollama model everywhere unless a lane says otherwise.
# Bare Ollama tag or full `provider:model` ref. Empty → muse-glimmer:30b.
# Inlined at build: restart `next dev` after changing.
PRIMARY_MODEL=muse-glimmer:30b
# Descriptive pins for parity with Foundry (Prism doesn't read these; Foundry uses them when serving PRIMARY).
PRIMARY_ALIAS=muse128
PRIMARY_QUANT=Q4_K_M
PRIMARY_CTX=131072
# Prior student (Lightning). Only used by lanes that explicitly opt in — never a silent default.
PRIOR_STUDENT_MODEL=nemotron-3.5-lightning:latest

# Context feeds
AIRTABLE_PAT=
AIRTABLE_BASE_SALES=
AIRTABLE_BASE_MGMT=
# Knowledge Cards are Notion — do not point at sales Territories
KNOWLEDGE_CARDS=
# Optional Airtable knowledge table (explicit only)
AIRTABLE_KNOWLEDGE_BASE=
AIRTABLE_KNOWLEDGE_TABLE=
GITHUB_PAT=
FIRECRAWL_API_KEY=
