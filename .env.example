# Copy to .env.local (never commit real keys)
# Or pull from your home env:
#   grep -E '^(OPENAI|XAI|OPEN_ROUTER|ANTHROPIC|AIRTABLE|GITHUB|KNOWLEDGE|FIRECRAWL)_' ~/.env >> .env.local

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# xAI / Grok
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1

# Anthropic (direct Messages API)
# Either name works — your ~/.env uses ANTHROPIC_CURSOR_API
ANTHROPIC_API_KEY=
ANTHROPIC_CURSOR_API=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# OpenRouter (Claude, open-source, many others — one key)
OPEN_ROUTER_HERMES_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:3001
OPENROUTER_APP_NAME=Prism

# Ollama (local; key optional)
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_API_KEY=

# Context feeds
AIRTABLE_PAT=
AIRTABLE_BASE_SALES=
AIRTABLE_BASE_MGMT=
# Knowledge Cards are Notion — do not point at sales Territories
KNOWLEDGE_CARDS=
# Optional Airtable knowledge table (explicit only)
AIRTABLE_KNOWLEDGE_BASE=
AIRTABLE_KNOWLEDGE_TABLE=
GITHUB_PAT=
FIRECRAWL_API_KEY=
