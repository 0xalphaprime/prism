# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# local IDE / Cursor (do not publish)
.cursor/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local lab exhaust (written by POST /api/lab/run-student)
/data/student-lab-last-run.json
/data/eval/experiments/

# board members, sessions and decisions (private; never commit)
/data/board/

# real company data — eval sets, private-only tests, the private-terms list,
# and agent plans that quote real accounts. The public repo ships only the
# fictional sample set (data/eval/sample-leftovers.v1.json).
/data/eval/private/
*.private.test.ts
/.private-terms
/.hermes/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

